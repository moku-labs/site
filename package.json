{
  "name": "site",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moku-labs/site.git"
  },
  "homepage": "https://moku-labs.com",
  "bugs": {
    "url": "https://github.com/moku-labs/site/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@moku-labs/web": "2.4.11",
    "preact": "10.29.2",
    "preact-render-to-string": "6.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@moku-labs/ci": "1.5.7",
    "@types/bun": "1.4.2",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-unicorn": "63.0.0",
    "lefthook": "2.1.1",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "4.0.18",
    "wrangler": "4.95.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/serve.ts",
    "preview": "bun scripts/preview.ts",
    "deploy": "bun scripts/deploy.ts",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage"
  }
}
