{
  "name": "site",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moku-labs/site.git"
  },
  "homepage": "https://moku-labs.com",
  "bugs": {
    "url": "https://github.com/moku-labs/site/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@moku-labs/web": "2.4.19",
    "preact": "10.29.2",
    "preact-render-to-string": "6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.4.16",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@moku-labs/ai": "0.16.13",
    "@moku-labs/ci": "1.5.8",
    "@moku-labs/editor": "0.10.21",
    "@moku-labs/game": "0.15.95",
    "@moku-labs/native": "0.3.15",
    "@moku-labs/room": "0.8.18",
    "@moku-labs/system": "0.3.8",
    "@moku-labs/worker": "0.20.11",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.2",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-unicorn": "63.0.0",
    "lefthook": "2.1.1",
    "oxlint": "1.86.0",
    "satori": "0.19.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "4.0.18",
    "wrangler": "4.95.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "og": "bun scripts/og.ts",
    "dev": "bun scripts/serve.ts",
    "preview": "bun scripts/preview.ts",
    "deploy": "bun scripts/deploy.ts",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:update:linux": "docker run --rm --network host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble bash -c \"npm i -g bun && bun install && bunx playwright test --update-snapshots\""
  }
}
